{
  "name": "gesture-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src e2e scripts *.ts *.mjs",
    "check:boundaries": "node --test scripts/import-boundaries.test.mjs && node scripts/import-boundaries.mjs",
    "api:generate": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "typecheck:tools": "tsc -p tsconfig.tools.json"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.1",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "axios-mock-adapter": "^2.1.0",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.1.6",
    "typescript-eslint": "8.72.2",
    "vite": "^7.1.12",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "eslint": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.8"
    }
  }
}
