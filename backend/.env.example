DATABASE_URL=postgresql://rslhelper:replace-database-password@postgres:5432/sign_language_db
DATABASE_URL_ASYNC=postgresql+asyncpg://rslhelper:replace-database-password@postgres:5432/sign_language_db

SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_USER=local
SMTP_PASSWORD=local
EMAIL_FROM=noreply@example.test

FRONTEND_URL=http://localhost:5173

DEBUG=True

S3_ENDPOINT_URL=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=videos
S3_REGION=us-east-1
