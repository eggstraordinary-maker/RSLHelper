# Docker Compose: database host is postgres:5432, not localhost.
# Keep these credentials consistent with postgres/.env.
DATABASE_URL=postgresql://rslhelper:replace-with-a-long-random-password@postgres:5432/sign_language_db
DATABASE_URL_ASYNC=postgresql+asyncpg://rslhelper:replace-with-a-long-random-password@postgres:5432/sign_language_db

SECRET_KEY=replace-with-a-long-random-secret-before-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gmail signature; replace only the mailbox/app password below for real mail.
# Other providers may require port 587 with SMTP_SECURITY=starttls instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_AUTH=true
SMTP_TIMEOUT_SECONDS=10
SMTP_USER=your-mailbox@example.com
SMTP_PASSWORD=replace-with-your-smtp-app-password
EMAIL_FROM=your-mailbox@example.com
FRONTEND_URL=http://localhost:5173

# Docker overrides endpoints and loads credentials from seaweedfs/.env.
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=videos
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-local-access-key
AWS_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
DEBUG=false
